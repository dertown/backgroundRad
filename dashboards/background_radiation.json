    "sv_home_annual": {
      "type": "splunk.singlevalue",
      "title": "Annualized dose",
      "dataSources": {
        "primary": "ds_home_annual"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "numberPrecision": 2,
        "majorFontSize": 40,
        "trendDisplay": "off",
        "sparklineDisplay": "off",
        "unit": "mSv/yr",
        "unitPosition": "after",
        "underLabel": "world average ~2.4 mSv/yr (all sources)",
        "majorColor": "> majorValue | rangeValue(majorColorConfig)"
      },
      "context": {
        "majorColorConfig": [
          {
            "to": 1,
            "value": "#52C41A"
          },
          {
            "from": 1,
            "to": 2.4,
            "value": "#FADB14"
