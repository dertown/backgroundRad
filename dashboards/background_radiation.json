            "to": 6,
            "value": "#FA8C16"
          },
          {
            "from": 6,
            "value": "#FF4D4F"
          }
        ]
      }
    },
    "gauge_home": {
      "type": "splunk.markergauge",
      "title": "Where home sits on the background scale (µSv/h)",
      "dataSources": {
        "primary": "ds_home_latest"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "orientation": "horizontal",
        "gaugeRanges": [
          {
            "from": 0,
            "to": 0.1,
            "value": "#52C41A"
          },
          {
            "from": 0.1,
            "to": 0.2,
            "value": "#FADB14"
          },
          {
            "from": 0.2,
            "to": 0.5,
            "value": "#FA8C16"
          },
          {
            "from": 0.5,
            "to": 1,
            "value": "#FF4D4F"
          }
        ],
        "labelDisplay": "number",
        "valueDisplay": "number"
      }
    },
    "area_home": {
      "type": "splunk.area",
      "title": "Dose rate over time (µSv/h, 10-minute average)",
      "dataSources": {
        "primary": "ds_home_area"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "legendDisplay": "off",
        "xAxisTitleVisibility": "hide",
        "seriesColors": [
          "#36CFC9"
        ],
        "areaOpacity": 0.35,
        "nullValueDisplay": "connect",
        "yAxisTitleText": "µSv/h"
      }
    },
    "line_home_cpm": {
      "type": "splunk.line",
      "title": "Count rate over time (CPM)",
      "dataSources": {
        "primary": "ds_home_cpm_line"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "legendDisplay": "off",
        "xAxisTitleVisibility": "hide",
        "seriesColors": [
          "#FFA940"
        ],
        "nullValueDisplay": "connect",
        "yAxisTitleText": "CPM"
      }
    },
    "col_home_hourly": {
      "type": "splunk.column",
      "title": "Average by hour of day (µSv/h)",
      "dataSources": {
        "primary": "ds_home_hourly"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "legendDisplay": "off",
        "xAxisTitleVisibility": "show",
        "seriesColors": [
          "#4C9AFF"
        ],
        "xAxisTitleText": "Hour"
      }
    },
    "col_home_hist": {
      "type": "splunk.column",
      "title": "How often each level occurs (10-minute intervals per µSv/h band)",
      "dataSources": {
        "primary": "ds_home_hist"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "legendDisplay": "off",
        "xAxisTitleVisibility": "hide",
        "seriesColors": [
          "#B37FEB"
        ]
      }
    },
    "md_home_scale": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "### Reading the numbers\n| Dose rate | What it means |\n|---|---|\n| **< 0.10 µSv/h** | Typical outdoor background in most places |\n| **0.10 – 0.20** | Normal for granite areas, altitude, or brick/stone buildings |\n| **0.20 – 0.50** | Elevated background; worth a second look |\n| **> 0.50** | Unusual for background; check the sensor and surroundings |\n\nIndoor Geiger counters often read differently from outdoor government monitors. 1 µSv/h for a full year is 8.76 mSv.",
        "fontColor": "#E6EDF3"
      }
    },
    "md_world_head": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "## Live world vs home\nLatest reading per station from public government networks: Germany, Finland, Austria, Switzerland (daily mean), Japan, Australia, United States (hourly) and Canada (terrestrial only, so it reads lower).",
        "fontColor": "#8B9BB4"
      }
    },
