        "primary": "ds_country_table"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "count": 20,
        "showInternalFields": false,
        "columnFormat": {
          "Median uSv/h": {
            "data": "> table | seriesByName(\"Median uSv/h\") | formatByType(Median_uSv_hFormat)",
            "rowBackgroundColors": "> table | seriesByName(\"Median uSv/h\") | rangeValue(Median_uSv_hBg)",
            "rowColors": "> table | seriesByName(\"Median uSv/h\") | rangeValue(Median_uSv_hFg)"
          },
          "Min": {
            "data": "> table | seriesByName(\"Min\") | formatByType(MinFormat)"
          },
          "Max": {
            "data": "> table | seriesByName(\"Max\") | formatByType(MaxFormat)",
            "rowBackgroundColors": "> table | seriesByName(\"Max\") | rangeValue(MaxBg)",
            "rowColors": "> table | seriesByName(\"Max\") | rangeValue(MaxFg)"
          },
          "Home uSv/h": {
            "data": "> table | seriesByName(\"Home uSv/h\") | formatByType(Home_uSv_hFormat)",
            "rowBackgroundColors": "> table | seriesByName(\"Home uSv/h\") | rangeValue(Home_uSv_hBg)",
            "rowColors": "> table | seriesByName(\"Home uSv/h\") | rangeValue(Home_uSv_hFg)"
          },
          "Home / country": {
            "data": "> table | seriesByName(\"Home / country\") | formatByType(Home___countryFormat)",
            "rowBackgroundColors": "> table | seriesByName(\"Home / country\") | rangeValue(Home___countryBg)",
            "rowColors": "> table | seriesByName(\"Home / country\") | rangeValue(Home___countryFg)"
          },
          "Comparison": {
            "data": "> table | seriesByName(\"Comparison\") | formatByType(ComparisonFormat)",
            "rowBackgroundColors": "> table | seriesByName(\"Comparison\") | matchValue(ComparisonBg)",
            "rowColors": "> table | seriesByName(\"Comparison\") | matchValue(ComparisonFg)"
