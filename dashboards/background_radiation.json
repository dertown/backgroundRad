{
  "title": "Background Radiation",
  "description": "Home Geiger readings compared with live public government radiation networks",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "visualizations": {
    "md_home_head": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "## Home sensor\nYour Geiger counter in `index=radsensor`, averaged into 10-minute intervals for the selected time range.",
        "fontColor": "#8B9BB4"
      }
    },
    "sv_home_latest": {
      "type": "splunk.singlevalue",
      "title": "Latest dose rate",
      "dataSources": {
        "primary": "ds_home_usvh_spark"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "numberPrecision": 4,
        "majorFontSize": 40,
        "trendDisplay": "absolute",
        "sparklineDisplay": "below",
        "unit": "µSv/h",
        "unitPosition": "after",
        "sparklineStrokeColor": "#36CFC9",
        "majorColor": "> majorValue | rangeValue(majorColorConfig)"
      },
      "context": {
        "majorColorConfig": [
          {
            "to": 0.1,
            "value": "#52C41A"
          },
          {
            "from": 0.1,
            "to": 0.2,
            "value": "#FADB14"
          },
          {
            "from": 0.2,
            "to": 0.5,
            "value": "#FA8C16"
          },
          {
            "from": 0.5,
            "to": 1,
            "value": "#FF4D4F"
          },
          {
            "from": 1,
            "value": "#B37FEB"
          }
        ]
      }
    },
    "sv_home_cpm": {
      "type": "splunk.singlevalue",
      "title": "Latest count rate",
      "dataSources": {
        "primary": "ds_home_cpm_spark"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "numberPrecision": 1,
        "majorFontSize": 40,
        "trendDisplay": "absolute",
        "sparklineDisplay": "below",
        "unit": "CPM",
        "unitPosition": "after",
        "sparklineStrokeColor": "#36CFC9",
        "majorColor": "#E6EDF3"
      }
    },
    "sv_home_avg": {
      "type": "splunk.singlevalue",
      "title": "Average in range",
      "dataSources": {
        "primary": "ds_home_avg"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "numberPrecision": 4,
        "majorFontSize": 40,
        "trendDisplay": "off",
        "sparklineDisplay": "off",
        "unit": "µSv/h",
        "unitPosition": "after",
        "majorColor": "> majorValue | rangeValue(majorColorConfig)"
      },
      "context": {
        "majorColorConfig": [
          {
            "to": 0.1,
            "value": "#52C41A"
          },
          {
            "from": 0.1,
            "to": 0.2,
            "value": "#FADB14"
          },
          {
            "from": 0.2,
            "to": 0.5,
            "value": "#FA8C16"
          },
          {
            "from": 0.5,
            "to": 1,
            "value": "#FF4D4F"
          },
          {
            "from": 1,
            "value": "#B37FEB"
          }
        ]
      }
    },
    "sv_home_peak": {
      "type": "splunk.singlevalue",
      "title": "Peak 10-minute average",
      "dataSources": {
        "primary": "ds_home_peak"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "numberPrecision": 4,
        "majorFontSize": 40,
        "trendDisplay": "off",
        "sparklineDisplay": "off",
        "unit": "µSv/h",
