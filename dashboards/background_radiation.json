  "dataSources": {
    "ds_home_base": {
      "type": "ds.search",
      "name": "Home sensor 10-minute series",
      "options": {
        "query": "index=radsensor sourcetype!=gov:radiation:json usvh=*\n| timechart span=10m avg(usvh) as usvh avg(cpm) as cpm"
      }
    },
    "ds_home_usvh_spark": {
      "type": "ds.chain",
      "name": "Home uSv/h sparkline",
      "options": {
        "extend": "ds_home_base",
        "query": "| where isnotnull(usvh)\n| fields _time usvh"
      }
    },
    "ds_home_cpm_spark": {
      "type": "ds.chain",
      "name": "Home CPM sparkline",
      "options": {
        "extend": "ds_home_base",
        "query": "| where isnotnull(cpm)\n| fields _time cpm"
      }
    },
    "ds_home_latest": {
      "type": "ds.chain",
      "name": "Home latest uSv/h",
      "options": {
        "extend": "ds_home_base",
        "query": "| where isnotnull(usvh)\n| stats latest(usvh) as usvh\n| eval usvh=round(usvh, 4)"
      }
    },
    "ds_home_avg": {
      "type": "ds.chain",
      "name": "Home period average",
      "options": {
        "extend": "ds_home_base",
        "query": "| stats avg(usvh) as avg_usvh\n| eval avg_usvh=round(avg_usvh, 4)"
      }
    },
    "ds_home_peak": {
      "type": "ds.chain",
      "name": "Home peak 10-minute average",
      "options": {
        "extend": "ds_home_base",
        "query": "| stats max(usvh) as peak_usvh\n| eval peak_usvh=round(peak_usvh, 4)"
      }
    },
    "ds_home_annual": {
      "type": "ds.chain",
      "name": "Home annualized dose",
      "options": {
        "extend": "ds_home_base",
        "query": "| stats avg(usvh) as avg_usvh\n| eval msv_per_year=round(avg_usvh*8760/1000, 2)\n| fields msv_per_year"
      }
    },
    "ds_home_area": {
      "type": "ds.chain",
      "name": "Home uSv/h over time",
      "options": {
        "extend": "ds_home_base",
        "query": "| fields _time usvh\n| rename usvh as \"uSv/h\""
      }
    },
    "ds_home_cpm_line": {
      "type": "ds.chain",
      "name": "Home CPM over time",
      "options": {
        "extend": "ds_home_base",
        "query": "| fields _time cpm\n| rename cpm as CPM"
      }
    },
    "ds_home_hourly": {
      "type": "ds.chain",
      "name": "Home by hour of day",
      "options": {
        "extend": "ds_home_base",
        "query": "| where isnotnull(usvh)\n| eval hour=strftime(_time, \"%H\")\n| stats avg(usvh) as \"Avg uSv/h\" by hour\n| eval \"Avg uSv/h\"=round('Avg uSv/h', 4)"
      }
    },
    "ds_home_hist": {
      "type": "ds.chain",
      "name": "Home reading distribution",
      "options": {
        "extend": "ds_home_base",
        "query": "| where isnotnull(usvh)\n| eval bucket=printf(\"%.3f\", floor(usvh*200)/200)\n| stats count as \"10-min intervals\" by bucket\n| sort bucket"
      }
    },
    "ds_world_median": {
      "type": "ds.search",
      "name": "World live median (median of country medians)",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n| stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n| stats median(usvh) as usvh by country\n| stats median(usvh) as world_usvh\n| eval world_usvh=round(world_usvh, 4)"
      }
    },
    "ds_home_vs_world": {
      "type": "ds.search",
      "name": "Home minus world",
      "options": {
        "query": "index=radsensor sourcetype!=gov:radiation:json usvh=*\n| stats latest(usvh) as home_usvh\n| appendcols [\n  search index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n  | stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n  | stats median(usvh) as usvh by country\n  | stats median(usvh) as world_usvh\n]\n| eval delta_usvh=round(home_usvh-world_usvh, 4)\n| fields delta_usvh"
      }
    },
    "ds_home_vs_world_ratio": {
      "type": "ds.search",
      "name": "Home over world",
      "options": {
        "query": "index=radsensor sourcetype!=gov:radiation:json usvh=*\n| stats latest(usvh) as home_usvh\n| appendcols [\n  search index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n  | stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n  | stats median(usvh) as usvh by country\n  | stats median(usvh) as world_usvh\n]\n| eval ratio=round(home_usvh/world_usvh, 2)\n| fields ratio"
      }
    },
    "ds_compare_status": {
      "type": "ds.search",
      "name": "Comparison status",
      "options": {
        "query": "index=radsensor sourcetype!=gov:radiation:json usvh=*\n| stats latest(usvh) as home_usvh\n| appendcols [\n  search index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n  | stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n  | stats median(usvh) as usvh by country\n  | stats median(usvh) as world_usvh\n]\n| eval comparison=case(\n  isnull(world_usvh), \"Waiting for government feeds\",\n  isnull(home_usvh), \"Waiting for home sensor\",\n  home_usvh > world_usvh*1.5, \"Home reads HIGHER than the live world median\",\n  home_usvh < world_usvh*0.67, \"Home reads LOWER than the live world median\",\n  1=1, \"Home is in line with the live world median\")\n| fields comparison"
      }
    },
    "ds_live_counts": {
      "type": "ds.search",
      "name": "Live countries and stations",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n| stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n| stats dc(country) as countries count as stations"
      }
    },
    "ds_live_countries": {
      "type": "ds.chain",
      "name": "Countries reporting",
      "options": {
        "extend": "ds_live_counts",
        "query": "| fields countries"
      }
    },
    "ds_live_stations": {
      "type": "ds.chain",
      "name": "Stations reporting",
      "options": {
        "extend": "ds_live_counts",
        "query": "| fields stations"
      }
    },
    "ds_map": {
      "type": "ds.search",
      "name": "Station map",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=* lat=* lon=*\n| stats latest(usvh) as usvh latest(lat) as lat latest(lon) as lon latest(station_name) as station_name latest(source_network) as source_network by country station_id\n| eval usvh=round(usvh, 4)\n| table lat lon usvh station_name country source_network"
      }
    },
    "ds_country_rank": {
      "type": "ds.search",
      "name": "Home vs country medians",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n| stats latest(usvh) as usvh latest(_time) as last_time by country station_id\n| stats median(usvh) as usvh by country\n| eval \"Country median\"=round(usvh, 4)\n| append [\n  search index=radsensor sourcetype!=gov:radiation:json usvh=*\n  | stats latest(usvh) as usvh\n  | eval country=\"Home sensor\", \"Home sensor\"=round(usvh, 4)\n]\n| sort - usvh\n| table country \"Country median\" \"Home sensor\""
      }
    },
    "ds_country_table": {
      "type": "ds.search",
      "name": "Live radiation by country vs home",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n| stats latest(usvh) as usvh latest(source_network) as source_network latest(dose_component) as dose_component latest(_time) as last_time by country station_id\n| stats count as stations median(usvh) as median_usvh min(usvh) as min_usvh max(usvh) as max_usvh max(last_time) as last_time first(source_network) as source_network first(dose_component) as dose_component by country\n| append [\n  | inputlookup typical_background.csv\n  | where region!=\"World\"\n  | rename region as country\n  | fields country typical_usvh\n]\n| stats first(*) as * by country\n| eval join_key=1\n| join type=left join_key [\n  search index=radsensor sourcetype!=gov:radiation:json usvh=*\n  | stats latest(usvh) as home_usvh\n  | eval join_key=1\n]\n| eval home_ratio=round(home_usvh/median_usvh, 2)\n| eval comparison=case(\n  isnull(median_usvh), \"No live data\",\n  isnull(home_usvh), \"Waiting for home\",\n  home_usvh > median_usvh*1.5, \"Home higher\",\n  home_usvh < median_usvh*0.67, \"Home lower\",\n  1=1, \"Similar\")\n| eval live=if(isnull(median_usvh), 0, 1)\n| eval last_reading=strftime(last_time, \"%Y-%m-%d %H:%M\")\n| foreach median_usvh min_usvh max_usvh home_usvh [ eval <<FIELD>>=round('<<FIELD>>', 4) ]\n| sort -live +country\n| table country source_network dose_component stations median_usvh min_usvh max_usvh typical_usvh home_usvh home_ratio comparison last_reading\n| rename country as Country source_network as Network dose_component as Dose stations as Stations median_usvh as \"Median uSv/h\" min_usvh as \"Min\" max_usvh as \"Max\" typical_usvh as \"Typical\" home_usvh as \"Home uSv/h\" home_ratio as \"Home / country\" comparison as Comparison last_reading as \"Last reading\""
      }
    },
    "ds_compare_time": {
      "type": "ds.search",
      "name": "Home vs countries over time",
      "options": {
        "query": "index=radsensor ((sourcetype!=gov:radiation:json usvh=*) OR (sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=network_summary station_count>0))\n| eval series=if(sourcetype==\"gov:radiation:json\", country, \"Home sensor\")\n| eval usvh_plot=if(sourcetype==\"gov:radiation:json\", median_usvh, usvh)\n| timechart span=1h limit=20 avg(usvh_plot) by series"
      }
    },
    "ds_stations": {
      "type": "ds.search",
      "name": "Highest stations",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type=station usvh=*\n| stats latest(usvh) as usvh latest(station_name) as station_name latest(_time) as last_time by country station_id\n| sort - usvh\n| head 25\n| eval usvh=round(usvh, 4), measured=strftime(last_time, \"%m-%d %H:%M\")\n| table station_name country usvh measured\n| rename station_name as Station country as Country usvh as \"uSv/h\" measured as Measured"
      }
    },
    "ds_network_table": {
      "type": "ds.search",
      "name": "Feed status by network",
      "options": {
        "query": "index=radsensor sourcetype=gov:radiation:json collector=\"background_radiation-*\" event_type IN (network_summary, source_error)\n| stats latest(event_type) as last_event latest(error) as last_error latest(station_count) as station_count latest(stale_dropped) as stale_dropped latest(_time) as last_time by source_network\n| eval Status=if(last_event==\"source_error\", \"Error\", \"OK\")\n| eval Detail=if(Status==\"Error\", last_error, station_count.\" stations\".if(stale_dropped>0, \", \".stale_dropped.\" stale dropped\", \"\"))\n| eval \"Last poll\"=strftime(last_time, \"%m-%d %H:%M\")\n| rename source_network as Network\n| table Network Status Detail \"Last poll\"\n| sort Network"
      }
    },
    "ds_typical": {
      "type": "ds.search",
      "name": "Typical published background",
      "options": {
        "query": "| inputlookup typical_background.csv\n| table region network agency typical_usvh range_low_usvh range_high_usvh dose_component\n| rename region as Region network as Network agency as Agency typical_usvh as \"Typical uSv/h\" range_low_usvh as Low range_high_usvh as High dose_component as Dose"
      }
    }
  },
