    "map_world": {
      "type": "splunk.map",
      "title": "Live government stations",
      "dataSources": {
        "primary": "ds_map"
      },
      "options": {
        "backgroundColor": "#131D2E",
        "center": [
          35,
          10
        ],
        "zoom": 1.6,
        "layers": [
          {
            "type": "marker",
            "latitude": "> primary | seriesByName('lat')",
            "longitude": "> primary | seriesByName('lon')",
            "dataColors": "> primary | seriesByName('usvh') | rangeValue(markerColors)",
            "additionalTooltipFields": [
